generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ===== ACADEMIC STRUCTURE TABLES =====

model Programme {
  id            String @id @default(cuid())
  session       String // CONSISTENT FORMAT: "2022-2026", "2023-2027", etc.
  programmeCode String // e.g., "BTECH_CSE", "BSC_CS"
  programmeName String
  duration      Int    // Duration in years
  semester      Int    // Current semester (not total)
  section       String? // Changed from "sections" to "section", now nullable
  noOfStudents  Int    // Number of students
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  courses       Course[]
  students      Student[]  // Link students to programmes
  
  @@unique([session, programmeCode])
  @@unique([programmeCode])
  @@map("programmes")
}

model Course {
  id            String @id @default(cuid())
  session       String // CONSISTENT FORMAT: "2022-2026", "2023-2027", etc.
  programmeCode String
  programmeName String // Denormalized
  semester      Int
  courseCode    String
  courseName    String
  l             Int    // Lecture hours
  t             Int    // Tutorial hours
  p             Int    // Practical hours
  s             Int    // Self-study hours
  credits       Float
  totalHours    Int
  courseType    CourseType
  roomNo        String?
  hasAttendance Boolean @default(true)
  courseNature  CourseNature
  courseMode    CourseMode
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  programme     Programme @relation(fields: [programmeCode], references: [programmeCode])
  facultyCourses FacultyCourse[]
  courseContent CourseContent[]  // Link to content
  
  @@unique([session, programmeCode, semester, courseCode])
  @@unique([session, courseCode])
  @@map("courses")
}

model Faculty {
  id          String @id @default(cuid())
  facultyId   String @unique
  facultyName String
  designation String
  email       String @unique
  contactNo   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  facultyCourses FacultyCourse[]
  uploadedContent CourseContent[] @relation("UploadedBy")  // Content uploaded by faculty
  coordinatorApprovals CourseContent[] @relation("CoordinatorApproval")  // Content approved as coordinator
  adminApprovals CourseContent[] @relation("AdminApproval")  // Content approved as admin
  user        User?  // Link to authentication
  
  @@map("faculty")
}

model FacultyCourse {
  id            String @id @default(cuid())
  session       String // CONSISTENT FORMAT: "2022-2026", "2023-2027", etc.
  programmeName String
  programmeCode String
  section       String // Specific section (e.g., "A", "B", "Section-1")
  courseCode    String
  courseName    String
  facultyId     String
  facultyName   String
  designation   String
  email         String
  contactNo     String
  role          FacultyRole @default(CONTRIBUTOR)
  assignedAt    DateTime @default(now())
  
  faculty       Faculty @relation(fields: [facultyId], references: [facultyId], onDelete: Cascade)
  course        Course @relation(fields: [session, courseCode], references: [session, courseCode], onDelete: Cascade)
  
  @@unique([session, facultyId, courseCode, section])
  @@map("faculty_courses")
}

// ===== STUDENT MANAGEMENT =====

model Student {
  id            String @id @default(cuid())
  studentId     String @unique
  studentName   String
  email         String @unique
  contactNo     String?
  programmeCode String
  session       String  // CONSISTENT FORMAT: "2022-2026", "2023-2027", etc.
  currentSemester Int   // Current semester they're in
  section       String  // Which section (A, B, C, etc.)
  status        StudentStatus @default(ACTIVE)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  programme     Programme @relation(fields: [programmeCode], references: [programmeCode])
  user          User?  // Link to authentication
  
  @@map("students")
}

// ===== CONTENT MANAGEMENT SYSTEM =====

model ContentCategory {
  id          String @id @default(cuid())
  name        String @unique  // e.g., "CHO", "Lecture PPTs", "Question Bank"
  description String?
  allowMultiple Boolean @default(true)  // CHO = false, others = true
  sortOrder   Int @default(0)
  isActive    Boolean @default(true)
  createdAt   DateTime @default(now())
  
  content     CourseContent[]
  
  @@map("content_categories")
}

model CourseContent {
  id            String @id @default(cuid())
  
  // Basic Info
  title         String
  description   String?
  
  // Course Relationship  
  courseId      String
  session       String // CONSISTENT FORMAT: "2022-2026", "2023-2027", etc.
  courseCode    String
  
  // Content Details
  categoryId    String
  fileName      String
  filePath      String  // Supabase storage path
  fileSize      Int?
  fileType      String  // MIME type
  lectureNumber Int?    // For lecture PPTs (Lecture 1, 2, 3...)
  
  // Upload Info
  uploadedById  String
  uploadedAt    DateTime @default(now())
  
  // Approval Workflow
  status        ContentStatus @default(PENDING)
  
  // Coordinator Review
  coordinatorApprovedById String?
  coordinatorApprovedAt   DateTime?
  coordinatorComments     String?
  
  // Admin Review  
  adminApprovedById      String?
  adminApprovedAt        DateTime?
  adminComments          String?
  
  // Timestamps
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  // Relationships
  course        Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  category      ContentCategory @relation(fields: [categoryId], references: [id])
  uploadedBy    Faculty @relation("UploadedBy", fields: [uploadedById], references: [id])
  coordinatorApprover Faculty? @relation("CoordinatorApproval", fields: [coordinatorApprovedById], references: [id])
  adminApprover Faculty? @relation("AdminApproval", fields: [adminApprovedById], references: [id])
  
  @@unique([courseId, categoryId, lectureNumber]) // Prevent duplicate lecture numbers
  @@map("course_content")
}

// ===== USER AUTHENTICATION =====

model User {
  id        String @id @default(cuid())
  email     String @unique
  role      UserRole
  isActive  Boolean @default(true)
  lastLogin DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Link to profile based on role
  facultyId String? @unique
  studentId String? @unique
  
  faculty   Faculty? @relation(fields: [facultyId], references: [id])
  student   Student? @relation(fields: [studentId], references: [id])
  
  @@map("users")
}

// ===== ENUMS =====
enum CourseType {
  INDUSTRY
  SKILL
  SEC
  CORE
  OPEN_ELECTIVE
  VAC
  AEC
  DSE
  INTERNSHIP
  PROJECT
  MOOC
  CS
  OTHER
  
  @@map("course_type")
}

enum CourseNature {
  MANDATORY
  ELECTIVE
  
  @@map("course_nature")
}

enum CourseMode {
  THEORY
  PRACTICAL
  THEORY_PRACTICAL
  
  @@map("course_mode")
}

enum FacultyRole {
  COORDINATOR
  CONTRIBUTOR
  
  @@map("faculty_role")
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  GRADUATED
  SUSPENDED
  
  @@map("student_status")
}

enum ContentStatus {
  PENDING              // Just uploaded by faculty
  COORDINATOR_APPROVED // Approved by coordinator, waiting for admin
  ADMIN_APPROVED       // Final approval - visible to students
  REJECTED             // Rejected at any stage
  
  @@map("content_status")
}

enum UserRole {
  ADMIN
  FACULTY  
  STUDENT
  
  @@map("user_role")
}
