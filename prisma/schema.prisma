// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================
// USER & ROLE MANAGEMENT (Multi-Role Support)
// ============================================

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ✅ REMOVED: Single role field (now using UserRole for multi-role)
  // Relationships
  roles    UserRole[]  // ✅ NEW: Multi-role support
  faculty  Faculty?
  student  Student?

  @@map("users")
}

enum Role {
  ADMIN
  FACULTY
  STUDENT
}

// ✅ UPDATED: Simplified multi-role model
model UserRole {
  id        String   @id @default(uuid())
  userId    String
  role      Role
  isActive  Boolean  @default(true)  // ✅ NEW: Ability to deactivate roles
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([userId])
  @@index([role])
  @@map("user_roles")
}

// ============================================
// PROGRAMME MANAGEMENT
// ============================================

model Programme {
  id              String   @id @default(uuid())
  session         String   // e.g., "2024-2025"
  programmeCode   String   // e.g., "BTECH-CSE"
  programmeName   String   // e.g., "B.Tech Computer Science"
  duration        Int      // in years, e.g., 4
  currentSemester Int      // current running semester
  section         String?  // can be null (A, B, C, etc.)
  noOfStudents    Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relationships
  courses  Course[]
  students Student[]
  faculty  Faculty[]

  @@unique([session, programmeCode, section])
  @@map("programmes")
}

// ============================================
// LESSON PLAN MANAGEMENT
// ============================================

model LessonPlan {
  id            String   @id @default(uuid())
  courseId      String
  facultyId     String
  
  // Lesson plan fields
  title         String
  lectureNumber Int?
  datePlanned   DateTime
  dateConducted DateTime?
  topicsCovered String
  description   String?
  
  // Status
  status        LessonPlanStatus @default(DRAFT)
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relationships
  course        Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  faculty       Faculty  @relation(fields: [facultyId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([facultyId])
  @@index([status])
  @@map("lesson_plans")
}

enum LessonPlanStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

// ============================================
// COURSE HANDOUT (CHO) MANAGEMENT
// ============================================

model CourseHandout {
  id        String    @id @default(uuid())
  facultyId String
  courseId  String
  status    CHOStatus @default(DRAFT)
  
  // Basic Info (Fields 1-10)
  schoolName      String
  programme       String
  courseTitle     String
  courseCode      String
  ltpStructure    String
  credits         String
  prerequisite    String
  totalSessions   String
  courseFaculty   String
  facultyEmail    String
  
  // Course Content
  coursePerspective       String   @db.Text
  programOutcomes         Json     // Array of ProgramOutcome objects
  programSpecificOutcomes Json     // Array of ProgramOutcome objects
  courseOutcomes          Json     // Array of CourseOutcome objects
  syllabus                Json     // Array of SyllabusUnit objects
  assessmentStrategy      Json     // Array of AssessmentRow objects
  correlationMatrix       Json     // Array of CorrelationRow objects
  sessionPlan             Json     // Array of SessionPlan objects
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relationships
  faculty   Faculty  @relation(fields: [facultyId], references: [id], onDelete: Cascade)
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  
  @@unique([facultyId, courseId])
  @@index([facultyId])
  @@index([courseId])
  @@index([status])
  @@map("course_handouts")
}

enum CHOStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

// ============================================
// COURSE MANAGEMENT
// ============================================

model Course {
  id           String         @id @default(uuid())
  session      String         // e.g., "2024-2025"
  programmeId  String
  semester     Int            // 1-8
  courseCode   String
  courseName   String
  
  // L-T-P-S Credits System
  l            Int            @default(0) // Lecture hours
  t            Int            @default(0) // Tutorial hours
  p            Int            @default(0) // Practical hours
  s            Int            @default(0) // Self-study hours
  credits      Int            // Total credits
  totalHours   Int            // Total contact hours per week
  
  // Course Details
  courseType   CourseType     // Academic type
  deliveryMode DeliveryMode   @default(THEORY) // Theory/Practical/Both
  roomNo       String?
  attendance   Boolean        @default(true)
  category     CourseCategory // MANDATORY/ELECTIVE
  
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  // Relationships
  programme          Programme            @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  courseAllocations  CourseAllocation[]
  teachingContents   TeachingContent[]
  studentEnrollments StudentEnrollment[]
  lessonPlans        LessonPlan[]
  courseHandouts     CourseHandout[]

  @@unique([session, courseCode, programmeId])
  @@index([programmeId])
  @@index([session])
  @@map("courses")
}

enum CourseType {
  CORE              // Core Course
  SEC               // Skill Enhancement Course
  INDUSTRY          // Industry Course
  SKILL             // Skill Course
  VAC               // Value Added Course
  OPEN_ELECTIVE     // Open Elective
  AEC               // Ability Enhancement Course
  DSE               // Discipline Specific Elective
  INTERNSHIP        // Internship
  PROJECT           // Project
  MOOC              // MOOC Course
  CS                // Community Service
  OTHER             // Other (define in description)
}

enum DeliveryMode {
  THEORY            // Theory only
  PRACTICAL         // Practical/Lab only
  BOTH              // Both Theory and Practical
}

enum CourseCategory {
  MANDATORY
  ELECTIVE
}

// ============================================
// FACULTY MANAGEMENT
// ============================================

model Faculty {
  id          String   @id @default(uuid())
  userId      String   @unique
  facultyId   String   @unique
  name        String
  designation String   // Professor, Assistant Professor, etc.
  email       String   @unique
  contactNo   String?
  department  String?
  programmeId String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relationships
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  programme         Programme?           @relation(fields: [programmeId], references: [id], onDelete: SetNull)
  courseAllocations CourseAllocation[]
  teachingContents  TeachingContent[]
  lessonPlans       LessonPlan[]
  courseHandouts    CourseHandout[]

  @@index([userId])
  @@index([programmeId])
  @@map("faculty")
}

// ============================================
// COURSE ALLOCATION (Faculty to Course Mapping)
// ============================================

model CourseAllocation {
  id        String            @id @default(uuid())
  courseId  String
  facultyId String
  role      FacultyCourseRole @default(CONTRIBUTOR)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  // Relationships
  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  faculty Faculty @relation(fields: [facultyId], references: [id], onDelete: Cascade)

  @@unique([courseId, facultyId])
  @@index([courseId])
  @@index([facultyId])
  @@map("course_allocations")
}

enum FacultyCourseRole {
  COORDINATOR
  CONTRIBUTOR
}

// ============================================
// TEACHING CONTENT (File Metadata - points to Supabase Storage)
// ============================================

model TeachingContent {
  id              String         @id @default(uuid())
  courseId        String
  facultyId       String
  contentType     ContentType
  title           String
  description     String?
  lectureNumber   Int?           // For lecture PPTs
  
  // Supabase Storage Info
  filePath        String         // Path in Supabase Storage
  fileName        String
  fileSize        Int?           // in bytes
  mimeType        String?

  // Approval Workflow
  approvalStatus  ApprovalStatus @default(PENDING)
  coordinatorNotes String?       @db.Text

  // Revision workflow (NEW)
  updatedFromId   String?        // If this is a revision, link to the previous version
  previousVersion TeachingContent? @relation("RevisionChain", fields: [updatedFromId], references: [id])
  revisions       TeachingContent[] @relation("RevisionChain")

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // Relationships
  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  faculty Faculty @relation(fields: [facultyId], references: [id], onDelete: Cascade)

  @@index([courseId])
  @@index([facultyId])
  @@index([approvalStatus])
  @@map("teaching_contents")
}

enum ContentType {
  COURSE_HANDOUT      // Course Handouts (CHO)
  LECTURE_PPT         // Lecture PPTs
  ASSIGNMENT          // Assignments
  QUESTION_BANK       // Question Bank
  QUESTION_PAPER      // Question Papers
  LAB_MANUAL          // Lab Manual
  LAB_ASSIGNMENT      // Lab Assignments
  REFERENCE_MATERIAL  // Reference Materials
}

enum ApprovalStatus {
  PENDING
  APPROVED
  CHANGES_REQUIRED
  REJECTED
}

// ============================================
// STUDENT MANAGEMENT
// ============================================

model Student {
  id              String   @id @default(uuid())
  userId          String   @unique
  studentId       String   @unique // Roll number
  name            String
  email           String   @unique
  contactNo       String?
  programmeId     String
  currentSemester Int
  section         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relationships
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  programme   Programme           @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  enrollments StudentEnrollment[]

  @@index([userId])
  @@index([programmeId])
  @@map("students")
}

// ============================================
// STUDENT ENROLLMENTS (Student to Course Mapping)
// ============================================

model StudentEnrollment {
  id         String   @id @default(uuid())
  studentId  String
  courseId   String
  enrolledAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relationships
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([studentId, courseId])
  @@index([studentId])
  @@index([courseId])
  @@map("student_enrollments")
}
