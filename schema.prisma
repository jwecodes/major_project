// Define database connection via the DATABASE_URL env var
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Define custom output path for generated Prisma Client
generator client {
  provider = "prisma-client-js"
  output   = "/app/generated/prisma-client"
}

model Programme {
  id        Int      @id @default(autoincrement())
  session   String
  code      String   @unique
  name      String
  duration  Int
  semesters Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  // Relationships
  courses   Course[]
  faculties Faculty[]
  
  @@map("programmes")
}

model Course {
  id            Int      @id @default(autoincrement())
  session       String
  programmeCode String
  programmeName String
  code          String   @unique
  name          String
  credit        Int
  type          String
  numStudents   Int      @map("no_of_students")
  L             Int      // Lecture hours
  T             Int      // Tutorial hours  
  P             Int      // Practical hours
  hours         Int
  roomNo        String   @map("room_no")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  // Foreign Key Relationship
  programme     Programme @relation(fields: [programmeCode], references: [code])
  faculties     Faculty[]
  
  @@map("courses")
}

model Faculty {
  id            Int      @id @default(autoincrement())
  programmeCode String
  programmeName String
  courseCode    String
  courseName    String
  facultyId     String   @unique
  name          String
  designation   String?
  contactNo     String?  @map("contact_no")
  email         String   @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  // Foreign Key Relationships
  programme     Programme @relation(fields: [programmeCode], references: [code])
  course        Course    @relation(fields: [courseCode], references: [code])
  
  @@map("faculties")
}